{
  "expo": {
    "name": "HabitQuest",
    "slug": "HabitQuest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "habitquest",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5D9C0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tirmazilabs.habitquest",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "HabitQuest needs microphone access for voice conversations with Dr. Sage.",
        "NSSpeechRecognitionUsageDescription": "HabitQuest needs speech recognition to transcribe your voice.",
        "NSPhotoLibraryUsageDescription": "HabitQuest may need access to your photo library to set a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5D9C0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tirmazilabs.habitquest"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#EB6D3A"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "HabitQuest needs microphone access for voice conversations with Dr. Sage.",
          "speechRecognitionPermission": "HabitQuest needs speech recognition to transcribe your voice."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2aa1ee8a-b944-4fc8-90d5-156c3c8ac377"
      }
    }
  }
}
